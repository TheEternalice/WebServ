{
	"version": "0.2.0",
	"configurations": [
		{
		"name": "Debug Webserv",
		"type": "cppdbg",
		"request": "launch",
		"program": "${workspaceFolder}/webserv",
		"args": ["conf_file/valid_file/basic_file.conf"],
		"stopAtEntry": false,
		"cwd": "${workspaceFolder}",
		"environment": [],
		"externalConsole": false,
		"MIMode": "gdb",
		"setupCommands": [
			{ "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
		],
		"preLaunchTask": "build"
		}
	]
}