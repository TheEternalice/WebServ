{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug serveur C++",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/webserv",  // exécutable généré
            "args": [],                              // arguments (ex: fichier conf)
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Activer l'impression des types STL",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}
